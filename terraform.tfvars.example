aws_region = "us-west-2"
project_name = "kilnwatch"
environment = "hackathon"
bucket_name_prefix = "kiln-watch-bucket"

db_name = "kilnwatch"
db_username = "kilnwatch_admin"
db_instance_class = "db.t4g.micro"
enable_amplify = false
frontend_repository_url = ""
frontend_branch = "main"

enable_sagemaker_training_job = false
sagemaker_training_image_uri = ""
sagemaker_training_instance_type = "ml.m5.large"
sagemaker_max_runtime_seconds = 3600

enable_agentcore = false
agent_image_tag = "v1"
agent_model_id = "global.anthropic.claude-sonnet-4-6"
agent_temperature = 0.1
agentcore_idle_timeout_seconds = 300
agentcore_max_lifetime_seconds = 1800

alert_email = ""
create_demo_ecs_service = false

# Set to the exact deployed https:// origin before enabling Amplify.
frontend_origin = ""
inference_image_tag = "bootstrap"
